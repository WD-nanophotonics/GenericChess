  "mixed_board_size_dependence": "any other outcome",
  "unsupported_handling": "a board size that the generator or the profile cannot build is recorded as unsupported and excluded from the decision; it is never replaced by a fabricated or interpolated result",
  "tie_handling": "the two decision branches are mutually exclusive by construction because 0.5 < 0.75; no seed is dropped from any board size"
 },
