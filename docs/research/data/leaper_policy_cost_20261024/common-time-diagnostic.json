{
  "derivation_source_utf8": "import json,hashlib,statistics,sys\nfrom collections import defaultdict\nfrom pathlib import Path\nsys.path.insert(0,str(Path.cwd()))\nfrom decimal import Decimal,localcontext\ndef exact_spearman(x,y):\n def rank2(v):return [1+2*sum(b<a for b in v)+sum(b==a for b in v) for a in v]\n a=rank2(x);b=rank2(y);n=len(a);cov=n*sum(u*v for u,v in zip(a,b))-sum(a)*sum(b);va=n*sum(u*u for u in a)-sum(a)**2;vb=n*sum(u*u for u in b)-sum(b)**2\n with localcontext() as ctx:\n  ctx.prec=80\n  return float(Decimal(cov)/Decimal(va*vb).sqrt())\nfrom scripts.leaper_cost_decomposition import rank_correlation\nfrom tools.local_agent.common import write_json\nsource=Path('.local_agent/bb-public-qualification.json');allrows=json.loads(source.read_bytes())['policy_analysis']['rows'];labels=('staticQ0','checkQ0','ordinaryQ4');indexed={a:{r['seed']:r for r in allrows if r['label']==a} for a in labels};out=[];members={}\nfor n in (4,5,6):\n seeds=sorted(s for s,r in indexed['staticQ0'].items() if r['n']==n and all(indexed[a][s]['reason']=='time_limit' for a in labels));members[str(n)]=seeds\n for label in labels:\n  rows=[indexed[label][s] for s in seeds];groups=defaultdict(list)\n  for r in rows:groups[r['mask']].append(r)\n  means=[{'x':statistics.mean(r['forward2_width'] for r in g),'y':statistics.mean(r['total_work'] for r in g)} for g in groups.values()]\n  x=[r['forward2_width'] for r in rows];y=[r['total_work'] for r in rows];xm=[r['x'] for r in means];ym=[r['y'] for r in means];root=exact_spearman(x,y);rule=exact_spearman(xm,ym)\n  assert abs(root-rank_correlation(x,y))<1e-12 and abs(rule-rank_correlation(xm,ym))<1e-12\n  out.append({'n':n,'label':label,'common_root_count':len(rows),'common_rule_count':len(groups),'width_paid_event_root_rho':root,'width_paid_event_rule_mean_rho':rule})\nr={'schema':'genericchess.common_time_diagnostic.v1','post_registration':True,'new_Player_calls':0,'packet_sha256':hashlib.sha256(Path('docs/research/data/leaper_policy_cost_20261024/packet.json.gz').read_bytes()).hexdigest(),'independent_arithmetic':'Pairwise twice-average ranks, exact integer covariance and Decimal80 sqrt; crosschecked against existing sorted/Counter float implementation. SciPy was unavailable; no package installed.','membership':members,'rows':out,'derivation_source_utf8':Path(__file__).read_bytes().decode('utf-8'),'scope':'Only sameinput intersection time_limit underALL3leafpolicies. Exactsame seedswithinboard acrosspolicies, yetselectedonpost-treatmentstop andcorrelatedexposedrules. Descriptiveconditionaldiagnostic, notpopulationorcausal effect; keeporiginalALL/perpolicystrata.'};write_json(Path('docs/research/data/leaper_policy_cost_20261024/common-time-diagnostic.json'),r)\nfor row in out:print(row)\n",
