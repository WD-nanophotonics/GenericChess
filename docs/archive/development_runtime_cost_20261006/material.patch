 /// evaluation of the position from the point of view of the side to move.
 
 Value Eval::evaluate(const Position& pos) {
+#ifdef GENERICCHESS_MATERIAL_DEVELOPMENT
+  // Standard-Chess development only: material leaf without positional terms.
+  // CapturePieceValue follows variant config; other search thresholds do not.
+  int material = 0;
+  for (PieceType pt : {PAWN, KNIGHT, BISHOP, ROOK, QUEEN})
+      material += EvalPieceValue[MG][pt] * (pos.count(WHITE, pt) - pos.count(BLACK, pt));
+  if (pos.side_to_move() == BLACK) material = -material;
+  return Value(std::clamp(material, int(VALUE_TB_LOSS_IN_MAX_PLY + 1), int(VALUE_TB_WIN_IN_MAX_PLY - 1)));
+#endif
+
 
   Value v;
 
