  "changed_only": "engine/yaneuraou-engine/yaneuraou-search.cpp",
  "patched_source_sha256": "25306962c7b42df7df247cdc318a3950f6de184dc72663c3723c3c514fa71bbd",
  "changes": [
    {
      "old": "using namespace Eval;  // Eval::PieceValue",
      "new": "using namespace Eval;  // Eval::PieceValue\n#if defined(DEV_AUX_FIRST_FUTILITY) && defined(EVAL_MATERIAL) && MATERIAL_LEVEL == 1\nnamespace {\nthread_local bool aux_first_effect_seen = false;\nbool aux_full_capture_mode() {\n    static const bool mode = [] { const char* p = std::getenv(\"DEV_AUX_CAPTURE_FUTILITY_MODE\"); return p && std::string(p) == \"1\"; }();\n    return mode;\n}\n}\n#endif\n"
    },
    {
      "old": "    while ((move = mp.next_move()) != Move::none())\n    {",
      "new": "    while ((move = mp.next_move()) != Move::none())\n    {\n#if defined(DEV_AUX_FIRST_FUTILITY) && defined(EVAL_MATERIAL) && MATERIAL_LEVEL == 1\n        bool aux_watch_move = false;\n        const Value aux_entry_alpha = alpha, aux_entry_beta = beta;\n#endif\n",
      "multiplicity": 2
    },
