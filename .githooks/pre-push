#!/bin/sh
set -eu
while read local_ref local_sha remote_ref remote_sha
do
  case "$remote_ref" in
    refs/heads/sandbox)
      [ "${GENERIC_CHESS_LOCAL_PUSH:-}" = "publish" ] || {
        echo "Use generic-chess-local.cmd publish for tested sandbox pushes" >&2
        exit 1
      }
      ;;
    refs/heads/master)
      [ "${GENERIC_CHESS_LOCAL_PUSH:-}" = "promote" ] || {
        echo "Use generic-chess-local.cmd promote for tested master fast-forwards" >&2
        exit 1
      }
      ;;
    *)
      echo "Unsupported project push target: $remote_ref" >&2
      exit 1
      ;;
  esac
  zeros=0000000000000000000000000000000000000000
  if [ "$remote_sha" != "$zeros" ] && [ "$local_sha" != "$zeros" ]; then
    git merge-base --is-ancestor "$remote_sha" "$local_sha" || {
      echo "Non-fast-forward push forbidden: $remote_ref" >&2
      exit 1
    }
  fi
done
